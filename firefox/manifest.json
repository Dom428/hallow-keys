{
  "manifest_version": 3,
  "name": "Hallow Keys",
  "version": "1.6.0",
  "description": "Fill logins, 2FA codes, cards and addresses, and sign in with passkeys, from Hallow Keys - the password manager on your PC. Only when you pick something.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hallow-keys@dom428.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Hallow Keys", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["webauthn-page.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://*/*"], "js": ["webauthn-bridge.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}